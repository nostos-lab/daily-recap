{
  "name": "dailyrecap",
  "displayName": "DailyRecap",
  "description": "AI 코딩 세션 로그를 읽어 '오늘의 의사결정 recap' 회고 문서를 자동 생성하고 Notion/Obsidian/로컬에 기록하는 BYOK VSCode 확장",
  "version": "0.0.1",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "recap.setApiKey",
        "title": "DailyRecap: API 키 설정",
        "category": "DailyRecap"
      },
      {
        "command": "recap.generate",
        "title": "DailyRecap: recap 생성",
        "category": "DailyRecap"
      }
    ],
    "configuration": {
      "title": "DailyRecap",
      "properties": {
        "recap.provider": {
          "type": "string",
          "enum": ["anthropic"],
          "default": "anthropic",
          "description": "LLM 제공자. v1은 anthropic 고정."
        },
        "recap.model": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "description": "사용할 Anthropic 모델명. 최신 모델명은 https://docs.claude.com 에서 확인."
        },
        "recap.source": {
          "type": "string",
          "enum": ["session", "git"],
          "default": "session",
          "description": "원재료 소스. session(Claude Code 세션 로그) 우선, git 폴백."
        },
        "recap.sink": {
          "type": "string",
          "enum": ["local", "obsidian", "notion"],
          "default": "local",
          "description": "recap 기록 목적지."
        },
        "recap.outputDir": {
          "type": "string",
          "default": "./recaps",
          "description": "LocalSink 출력 디렉터리."
        },
        "recap.obsidianVault": {
          "type": "string",
          "default": "",
          "description": "ObsidianSink 대상 vault 절대경로."
        },
        "recap.lang": {
          "type": "string",
          "enum": ["auto", "ko", "en"],
          "default": "auto",
          "description": "recap 출력 언어. auto는 IDE 로케일을 따름."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "for f in parser prompt llm sink e2e; do node --experimental-strip-types --import ./test/register-ts.mjs test/$f.test.ts || exit 1; done",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  }
}
